# Copie para .env e ajuste se precisar. O .env nunca e versionado (ver .gitignore).
# Sem .env, o docker-compose.yml usa estes mesmos valores como padrao.

# PostgreSQL (os tres bancos compartilham usuario e senha no ambiente local)
DB_USER=app
DB_PASSWORD=app

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
