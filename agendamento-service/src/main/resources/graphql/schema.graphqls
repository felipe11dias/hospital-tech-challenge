# agendamento-service — schema GraphQL.
#
# Sprint 0: apenas o campo minimo que o Spring for GraphQL exige para iniciar.
# O contrato real (agendarConsulta, atualizarConsulta, cancelarConsulta, registrarAtendimento) entra na Sprint 2 (specs/002 e 003), junto da spec que o define.
type Query {
  "Sonda de inicializacao. Removida quando o contrato real entrar."
  ping: String
}
